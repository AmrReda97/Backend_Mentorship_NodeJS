        <mxCell id="NDT7-LInYNdKvQQoB0aa-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;fillColor=#cdeb8b;strokeColor=#36393d;" value="&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;font style=&quot;line-height: 10.8px; font-size: 14px;&quot;&gt;ApproveVacationRequests(employee_id ,vacationRequestData ) {&lt;br&gt;&lt;/font&gt;&lt;/h1&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px;&quot;&gt;&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;font style=&quot;line-height: 10.8px;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;is_valid= &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;valdiateVacationRequest(&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;employee_id&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt; ,&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;vacationRequestData&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;)&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;&lt;font size=&quot;3&quot;&gt;if(!is_valid){return badRequest}&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;deducted_balance = vacationRequestDate.&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; font-size: medium; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;deductedBalance&lt;br&gt;new_employee_balance = old_employee_balance -&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: 400; font-size: medium; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;deducted_balance&lt;/span&gt;&lt;span style=&quot;font-weight: 400; font-size: medium; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; font-size: medium; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Try:&lt;br&gt;start TX:&lt;br&gt;updated_employee_balance_in_db(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: medium; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;new_employee_balance&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: medium; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: medium; font-weight: normal;&quot;&gt;)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: medium; font-weight: normal;&quot;&gt;update_request_status(approved)&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;span style=&quot;font-weight: 400; font-size: medium; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;commit TX&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-weight: 400; font-size: medium; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;catch(error): rollback TX and throw server error 500&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal; font-size: medium;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: medium; font-weight: normal;&quot;&gt;async sendVacationRequestApprovedEmail(&lt;/span&gt;&lt;span style=&quot;font-size: medium; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;employee_id&lt;/span&gt;&lt;span style=&quot;font-size: medium; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: medium; font-weight: normal;&quot;&gt;)&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;font size=&quot;3&quot; style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;return sucess&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal; font-size: medium;&quot;&gt;}&lt;/span&gt;&lt;/h1&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;ValdiateVacationRequest&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;(employee_id ,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;vacationRequestData&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;) {&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; employee_balance = getEmployeeBalance(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;employee_id&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;if Employee_balance &amp;lt; vacationRequestData.deductedBalance &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;or&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;vacationRequestDate.from &amp;gt;=&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;vacationRequestDate.to&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;or vacationRequestDate.vacationCategory === null or undefine&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;or&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;date_is_already_used(employee,&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;vacationRequestDate&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;.from,&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;vacationRequestDate.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;to)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;return false&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;else : return true&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;font size=&quot;3&quot;&gt;}&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 12px; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;/span&gt;&lt;/h1&gt;&lt;/div&gt;" vertex="1">
