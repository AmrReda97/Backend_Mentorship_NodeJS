style=&quot;background-color: transparent; font-weight: normal; font-size: medium; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;try:&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal; font-size: medium;&quot;&gt;createdRequestData&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal; font-size: medium;&quot;&gt;&amp;nbsp; =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: medium; font-weight: normal;&quot;&gt;save_vacation request_in_db(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: medium; font-weight: normal;&quot;&gt;vacationRequestData)&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;span style=&quot;font-weight: 400; font-size: medium; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;catch(error): rollback TX and throw server error 500&lt;br&gt;&lt;/span&gt;&lt;font size=&quot;3&quot; style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;result =&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal; font-size: medium;&quot;&gt;createdRequestData&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal; font-size: medium;&quot;&gt;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: medium; font-weight: normal;&quot;&gt;async sendVacationRequestEmail(manager_id)&lt;br&gt;&lt;/span&gt;&lt;font size=&quot;3&quot; style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;return&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: 400; font-size: medium;&quot;&gt;result&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: 400; font-size: medium;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal; font-size: medium;&quot;&gt;}&lt;/span&gt;&lt;/h1&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 21.6px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;ValdiateVacationRequest&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;(employee_id ,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;vacationRequestData&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;) {&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; employee_balance = getEmployeeBalance(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;employee_id&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;if Employee_balance &amp;lt; vacationRequestData.deductedBalance &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;or&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;vacationRequestDate.from &amp;gt;=&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;vacationRequestDate.to&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;or vacationRequestDate.vacationCategory === null or undefine&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;or&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;date_is_already_used(employee,&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;vacationRequestDate&lt;/span&gt;&lt;span style=&quo